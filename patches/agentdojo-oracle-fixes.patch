+++ b/tests/test_banking_user_tasks.py
@@ -0,0 +1,30 @@
+from copy import deepcopy
+
+import pytest
+
+from agentdojo.functions_runtime import FunctionsRuntime
+from agentdojo.task_suite.load_suites import get_suite
+
+
+@pytest.mark.parametrize("task_id", ["user_task_5", "user_task_6"])
+def test_state_changing_banking_task_rejects_unchanged_environment(task_id: str):
+    suite = get_suite("v1.2.2", "banking")
+    task = suite.get_user_task_by_id(task_id)
+    environment = suite.load_and_inject_default_environment({})
+
+    assert not task.utility("", environment, deepcopy(environment))
+
+
+@pytest.mark.parametrize("task_id", ["user_task_5", "user_task_6"])
+def test_state_changing_banking_task_accepts_ground_truth(task_id: str):
+    suite = get_suite("v1.2.2", "banking")
+    task = suite.get_user_task_by_id(task_id)
+    environment = suite.load_and_inject_default_environment({})
+    pre_environment = deepcopy(environment)
+    runtime = FunctionsRuntime(suite.tools)
+
+    for call in task.ground_truth(pre_environment):
+        _, error = runtime.run_function(environment, call.function, call.args)
+        assert error is None
+
+    assert task.utility(task.GROUND_TRUTH_OUTPUT, pre_environment, environment)
diff --git a/tests/test_oracle_argument_regressions.py b/tests/test_oracle_argument_regressions.py
new file mode 100644
index 00000000..21dbd7ce
--- /dev/null
+++ b/tests/test_oracle_argument_regressions.py
@@ -0,0 +1,51 @@
+import pytest
+
+from agentdojo.functions_runtime import FunctionsRuntime
+from agentdojo.task_suite.load_suites import get_suites
+
+
+CASES = [
+    ("banking", "user_task_11", "send_money", "recipient", "wrong-recipient"),
+    ("travel", "user_task_3", "send_email", "recipients", []),
+    ("workspace", "user_task_12", "create_calendar_event", "title", "wrong-title"),
+    ("slack", "user_task_2", "invite_user_to_slack", "user_email", "wrong@example.com"),
+]
+
+
+def evaluate(suite_name, task_id, function, argument, value=None):
+    suite = get_suites("v1.2.2")[suite_name]
+    task = suite.user_tasks[task_id]
+    environment = task.init_environment(suite.load_and_inject_default_environment({}))
+    pre_environment = environment.model_copy(deep=True)
+    calls = task.ground_truth(pre_environment.model_copy(deep=True))
+    if value is not None:
+        calls = list(calls)
+        index = next(i for i, call in enumerate(calls) if call.function == function)
+        args = dict(calls[index].args)
+        args[argument] = value
+        calls[index] = calls[index].model_copy(update={"args": args})
+    runtime = FunctionsRuntime(suite.tools)
+    for call in calls:
+        _, error = runtime.run_function(environment, call.function, call.args)
+        assert error is None
+    traced = task.utility_from_traces(task.GROUND_TRUTH_OUTPUT, pre_environment, environment, calls)
+    return traced if traced is not None else task.utility(task.GROUND_TRUTH_OUTPUT, pre_environment, environment)
+
+
+@pytest.mark.parametrize("suite_name,task_id,function,argument,bad_value", CASES)
+def test_oracle_rejects_wrong_required_argument(suite_name, task_id, function, argument, bad_value):
+    assert evaluate(suite_name, task_id, function, argument)
+    assert not evaluate(suite_name, task_id, function, argument, bad_value)
+
+
+@pytest.mark.parametrize(
+    "task_id,function,argument,allowed_value",
+    [
+        ("user_task_6", "schedule_transaction", "date", "2024-06-01"),
+        ("user_task_6", "schedule_transaction", "subject", "iPhone subscription service"),
+        ("user_task_11", "send_money", "date", "2023-10-05"),
+        ("user_task_11", "send_money", "subject", "VAT Adjustment for iPhone Purchase"),
+    ],
+)
+def test_banking_oracle_allows_unspecified_fields(task_id, function, argument, allowed_value):
+    assert evaluate("banking", task_id, function, argument, allowed_value)
