diff --git a/tests/test_user_task_oracle_regressions.py b/tests/test_user_task_oracle_regressions.py
new file mode 100644
index 00000000..9d2fc8b0
--- /dev/null
+++ b/tests/test_user_task_oracle_regressions.py
@@ -0,0 +1,56 @@
+from agentdojo.functions_runtime import FunctionCall, FunctionsRuntime
+from agentdojo.task_suite.load_suites import get_suite
+
+
+CASES = [
+    ("banking", "user_task_6", "schedule_transaction", "recipient", "wrong-recipient"),
+    ("banking", "user_task_11", "send_money", "recipient", "wrong-recipient"),
+    ("slack", "user_task_2", "invite_user_to_slack", "user_email", "wrong@example.com"),
+    ("travel", "user_task_3", "send_email", "recipients", []),
+    ("workspace", "user_task_12", "create_calendar_event", "title", "wrong-title"),
+]
+
+
+def evaluate(version, suite_name, task_id, function=None, argument=None, value=None):
+    suite = get_suite(version, suite_name)
+    task = suite.user_tasks[task_id]
+    environment = task.init_environment(suite.load_and_inject_default_environment({}))
+    pre_environment = environment.model_copy(deep=True)
+    calls = list(task.ground_truth(pre_environment.model_copy(deep=True)))
+    if function is not None:
+        index = next(i for i, call in enumerate(calls) if call.function == function)
+        args = dict(calls[index].args)
+        args[argument] = value
+        calls[index] = FunctionCall(function=calls[index].function, args=args)
+
+    runtime = FunctionsRuntime(suite.tools)
+    for call in calls:
+        _, error = runtime.run_function(environment, call.function, call.args)
+        assert error is None
+
+    traced = task.utility_from_traces(task.GROUND_TRUTH_OUTPUT, pre_environment, environment, calls)
+    if traced is not None:
+        return traced
+    return task.utility(task.GROUND_TRUTH_OUTPUT, pre_environment, environment)
+
+
+def test_v13_accepts_all_five_reference_executions():
+    for suite_name, task_id, *_ in CASES:
+        assert evaluate("v1.3", suite_name, task_id)
+
+
+def test_v13_rejects_all_five_wrong_required_arguments():
+    for suite_name, task_id, function, argument, value in CASES:
+        assert not evaluate("v1.3", suite_name, task_id, function, argument, value)
+
+
+def test_v122_keeps_historical_scoring_behavior():
+    for suite_name, task_id, function, argument, value in CASES:
+        assert evaluate("v1.2.2", suite_name, task_id, function, argument, value)
+
+
+def test_v13_allows_unspecified_banking_fields():
+    assert evaluate("v1.3", "banking", "user_task_6", "schedule_transaction", "date", "2026-01-01")
+    assert evaluate("v1.3", "banking", "user_task_6", "schedule_transaction", "subject", "subscription")
+    assert evaluate("v1.3", "banking", "user_task_11", "send_money", "date", "2026-01-01")
+    assert evaluate("v1.3", "banking", "user_task_11", "send_money", "subject", "VAT adjustment")
